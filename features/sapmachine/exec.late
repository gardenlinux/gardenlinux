#!/usr/bin/env bash

set -eufo pipefail

gpg --dearmor -o /etc/apt/keyrings/sapmachine-apt-keyring.gpg < /builder/features/sapmachine/sapmachine.key
echo "deb [signed-by=/etc/apt/keyrings/sapmachine-apt-keyring.gpg] https://dist.sapmachine.io/debian stable main" | tee /etc/apt/sources.list.d/sapmachine.list
apt-get update -y
apt-get install -y sapmachine-25-jre-headless
