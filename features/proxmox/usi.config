#!/usr/bin/dash
set -eufo pipefail

initrd_dir="$1"
#rootfs="$2"

mnt_file="$initrd_dir/etc/systemd/system/sysroot-etc.mount"
sed -i '/^After=setup-etc-overlay\.service$/d; /^Requires=setup-etc-overlay\.service$/d' "$mnt_file"
grep -q '^After=.*sysroot-var.mount' "$mnt_file" \
    || sed -i '/^\[Unit\]$/a After=sysroot-var.mount' "$mnt_file"
