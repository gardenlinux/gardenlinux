#!/usr/bin/env bash

set -euo pipefail

input="$(realpath -- "$1")"
output="$(realpath -- "$2")"

dir="$(mktemp -d)"
pushd "$dir" > /dev/null

mkdir -p blobs/sha256

rootfs_sha256="$(sha256sum < "$input" | head -c 64)"

zstd --rm < "$input" > layer
layer_sha256="$(sha256sum < layer | head -c 64)"
layer_size="$(stat -c '%s' layer)"
mv layer "blobs/sha256/$layer_sha256"

cat << EOF | jq -c . | tr -d '\n' > config
{
  "architecture": "$BUILDER_ARCH",
  "os": "linux",
  "config": {
    "Cmd": [ "/bin/bash" ],
    "Labels": {
      "org.opencontainers.image.title": "Garden Linux",
      "org.opencontainers.image.version": "$BUILDER_VERSION",
      "org.opencontainers.image.architecture": "$BUILDER_ARCH",
      "org.opencontainers.image.source": "https://github.com/gardenlinux/gardenlinux",
      "org.opencontainers.image.revision": "$BUILDER_COMMIT",
      "org.opencontainers.image.description": "Garden Linux $BUILDER_VERSION $BUILDER_ARCH $BUILDER_FEATURES"
}
  },
  "rootfs": {
    "type": "layers",
    "diff_ids": [
      "sha256:$rootfs_sha256"
    ]
  },
  "history": [{}]
}
EOF

config_sha256="$(sha256sum < config | head -c 64)"
config_size="$(stat -c '%s' config)"
mv config "blobs/sha256/$config_sha256"

cat << EOF | jq -c . | tr -d '\n' > manifest
{
  "schemaVersion": 2,
  "mediaType": "application/vnd.oci.image.manifest.v1+json",
  "config": {
    "mediaType": "application/vnd.oci.image.config.v1+json",
    "digest": "sha256:$config_sha256",
    "size": $config_size
  },
  "layers": [
    {
      "mediaType": "application/vnd.oci.image.layer.v1.tar+zstd",
      "digest": "sha256:$layer_sha256",
      "size": $layer_size
    }
  ]
}
EOF

manifest_sha256="$(sha256sum < manifest | head -c 64)"
manifest_size="$(stat -c '%s' manifest)"
mv manifest "blobs/sha256/$manifest_sha256"

cat << EOF | jq -c . | tr -d '\n' > index.json
{
  "schemaVersion": 2,
  "manifests": [
    {
      "mediaType": "application/vnd.oci.image.manifest.v1+json",
      "digest": "sha256:$manifest_sha256",
      "size": $manifest_size,
      "annotations": {
        "org.opencontainers.image.ref.name": "$(tr '[:upper:]' '[:lower:]' <<< "$BUILDER_FLAVOR")"
      }
    }
  ]
}
EOF

cat << EOF | jq -c . | tr -d '\n' > oci-layout
{
  "imageLayoutVersion": "1.0.0"
}
EOF

tar --mtime="$(date -d @$BUILDER_TIMESTAMP)" -c blobs index.json oci-layout > "$output"

popd > /dev/null
rm -rf "$dir"
