#!/usr/bin/env bash

set -eufo pipefail

input="$(realpath "$1")"
output="$(realpath "$2")"
artifact_base_name="$(basename "$output" .ova)"

dir="$(mktemp -d)"
pushd "$dir"

qemu-img convert -o subformat=streamOptimized -o adapter_type=lsilogic -f raw -O vmdk "$input" "$artifact_base_name.vmdk"
/builder/features/vmware/make-ova --vmdk "$artifact_base_name.vmdk" --guest-id debian10_64Guest --template /builder/features/vmware/vmware.ovf.template

tar -tf "$artifact_base_name.ova"

cp --sparse=always "$artifact_base_name.ova" "$output"

popd
rm -rf "$dir"
