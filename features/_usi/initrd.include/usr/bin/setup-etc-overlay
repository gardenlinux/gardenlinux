#!/bin/bash

set -eufo pipefail

overlay_dir="/sysroot/var/etc.overlay"
workdir="/sysroot/var/etc.overlay.workdir"
os_release_marker="$overlay_dir/os-release"
os_release_source="/sysroot/etc/os-release"
machine_id_file="$overlay_dir/machine-id"

if [ -d "$overlay_dir" ] && [ -d "$workdir" ] && [ -e "$os_release_marker" ] && cmp -s "$os_release_marker" "$os_release_source"; then
	exit 0
fi

if [ -e "$os_release_marker" ]; then
	chattr -i "$os_release_marker" || true
fi

# Preserve the machine-id across the /etc reset so the system keeps its identity.
machine_id=""
if [ -e "$machine_id_file" ]; then
	machine_id="$(cat "$machine_id_file")"
fi

rm -rf "$overlay_dir" "$workdir"
mkdir -p "$overlay_dir" "$workdir"

if [ -n "$machine_id" ]; then
	printf '%s\n' "$machine_id" > "$machine_id_file"
	chmod 0644 "$machine_id_file"
fi

cp "$os_release_source" "$os_release_marker"
chmod 0444 "$os_release_marker"
chattr +i "$os_release_marker"

echo > /run/gardenlinux-etc-reset
