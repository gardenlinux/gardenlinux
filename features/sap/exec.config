rule="/etc/audit/rules.d/70-privileged-special.rules.arm64"

if [ "$(uname -m)" = "x86_64" ]; then
	# remove arm specific rules on non arm architectures
	rm -f "$rule"
else
	mv "$rule" "${rule%.*}"
fi

# GL-TESTCOV-sap-config-shared-symlink
# /shared is a symlink into /var/shared so backup data can be stored there;
# root filesystem is read-only, /var is writable at runtime
mkdir -p /var/shared
ln -s /var/shared /shared
